{
  "name": "bosphorus-vibe",
  "private": true,
  "scripts": {
    "build": "cd next-app && npm run build",
    "dev": "cd next-app && npm run dev",
    "dev:clean": "cd next-app && npm run dev:clean",
    "dev:reset": "cd next-app && npm run dev:reset",
    "start": "cd next-app && npm start",
    "firebase:deploy:storage": "cd firebase && firebase deploy -P bosphorusvibe-dbd93 --only storage",
    "firebase:deploy:rules": "cd firebase && firebase deploy -P bosphorusvibe-dbd93 --only firestore:rules,storage",
    "firebase:deploy:functions": "cd firebase && firebase deploy -P bosphorusvibe-dbd93 --only functions",
    "firebase:deploy:transcode": "cd firebase && firebase deploy -P bosphorusvibe-dbd93 --only functions:transcodeVideoPost,functions:transcodeVideoPostOnUpdate,functions:processPendingVideoTranscodes,functions:runVideoTranscodeBatch,functions:adminRunTranscodeBatch,functions:runStorageVideoSyncBatch,functions:adminRunStorageVideoSync,functions:configureAllVideoStorage,functions:autoMaintainVideoStorage",
    "storage:configure": "node scripts/storage-video-pipeline.mjs",
    "storage:cors": "node scripts/storage-video-pipeline.mjs --cors-only",
    "firebase:deploy:thumbnails": "cd firebase && firebase deploy -P bosphorusvibe-dbd93 --only functions:processPendingVideoThumbnails,functions:runVideoThumbnailBatch,functions:adminRunThumbnailBatch",
    "firebase:deploy:indexes": "cd firebase && firebase deploy -P bosphorusvibe-dbd93 --only firestore:indexes",
    "deploy:firebase": "bash scripts/deploy-firebase.sh"
  }
}
