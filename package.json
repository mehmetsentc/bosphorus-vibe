{
  "name": "bosphorus-vibe",
  "private": true,
  "scripts": {
    "build": "cd next-app && npm run build",
    "dev": "cd next-app && npm run dev",
    "dev:clean": "cd next-app && npm run dev:clean",
    "dev:reset": "cd next-app && npm run dev:reset",
    "start": "cd next-app && npm start",
    "firebase:deploy:storage": "cd firebase && firebase deploy --only storage",
    "firebase:deploy:rules": "cd firebase && firebase deploy --only firestore:rules,storage",
    "firebase:deploy:functions": "cd firebase && firebase deploy --only functions:functions",
    "firebase:deploy:transcode": "cd firebase && firebase deploy --only functions:functions:transcodeVideoPost"
  }
}
