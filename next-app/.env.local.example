# Production site URL — MUST be the custom domain (not *.vercel.app) for SEO/sitemap.
NEXT_PUBLIC_SITE_URL=https://www.bosphorusvibe.com

# Optional override for sitemap, canonical and Open Graph (defaults to www.bosphorusvibe.com).
# NEXT_PUBLIC_CANONICAL_URL=https://www.bosphorusvibe.com

# --- Client (public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
# OAuth uses {PROJECT_ID}.firebaseapp.com automatically — keep for reference only
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bosphorusvibe-dbd93.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# reCAPTCHA Enterprise (for phone auth)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_site_key

# Optional analytics (requires cookie consent)
NEXT_PUBLIC_GA_ID=

# --- Server only (NEVER expose to client) ---
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Shared secret for admin video transcode backfill (must match Firebase Functions env)
TRANSCODE_BACKFILL_SECRET=generate_a_long_random_string
